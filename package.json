{
  "name": "relay-agent-workspace",
  "displayName": "Relay",
  "description": "Workspace locale in italiano per usare Codex, Claude Code, Antigravity e GitHub Copilot CLI in un'unica conversazione.",
  "version": "0.22.8",
  "publisher": "intelligenza-artificiale-italia",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/IntelligenzaArtificiale/relay-ai.git"
  },
  "homepage": "https://github.com/IntelligenzaArtificiale/relay-ai#readme",
  "bugs": {
    "url": "https://github.com/IntelligenzaArtificiale/relay-ai/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Chat"
  ],
  "keywords": [
    "codex",
    "claude",
    "antigravity",
    "copilot",
    "agents",
    "multi-agent"
  ],
  "main": "./dist/extension.js",
  "icon": "media/relay-icon.png",
  "galleryBanner": {
    "color": "#0b1020",
    "theme": "dark"
  },
  "preview": false,
  "qna": false,
  "contributes": {
    "commands": [
      {
        "command": "relay.open",
        "title": "Relay: Open",
        "icon": "$(sparkle)"
      },
      {
        "command": "relay.openAgents",
        "title": "Relay: Open Agent Studio",
        "icon": "$(hubot)"
      },
      {
        "command": "relay.openUsage",
        "title": "Relay: Open Provider Usage",
        "icon": "$(graph)"
      },
      {
        "command": "relay.openRemote",
        "title": "Relay: Open Remote Access",
        "icon": "$(device-mobile)"
      },
      {
        "command": "relay.refreshProviders",
        "title": "Relay: Refresh Providers"
      },
      {
        "command": "relay.setup",
        "title": "Relay: Configure Agents"
      },
      {
        "command": "relay.doctor",
        "title": "Relay: System Doctor"
      },
      {
        "command": "relay.resetUi",
        "title": "Relay: Ripristina interfaccia",
        "icon": "$(debug-restart)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "relay",
          "title": "Relay",
          "icon": "media/relay-mark.svg"
        }
      ]
    },
    "views": {
      "relay": [
        {
          "id": "relay.sidebar",
          "name": "Relay",
          "type": "webview",
          "icon": "media/relay-mark.svg"
        }
      ]
    },
    "configuration": {
      "title": "Relay",
      "properties": {
        "relay.executables.codex": {
          "type": "string",
          "default": "codex",
          "description": "Codex CLI executable or absolute path."
        },
        "relay.executables.claude": {
          "type": "string",
          "default": "claude",
          "description": "Claude Code CLI executable or absolute path."
        },
        "relay.executables.antigravity": {
          "type": "string",
          "default": "agy",
          "description": "Antigravity CLI executable or absolute path."
        },
        "relay.parallelism.maxRuns": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 12,
          "description": "Maximum simultaneous agent runs."
        },
        "relay.worktrees.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use isolated Git worktrees for parallel write tasks."
        },
        "relay.worktrees.root": {
          "type": "string",
          "default": "",
          "description": "Optional directory for temporary worktrees. Empty uses Relay global storage."
        },
        "relay.delegation.defaultPolicy": {
          "type": "string",
          "enum": [
            "confirm",
            "automatic",
            "disabled"
          ],
          "default": "confirm",
          "description": "Default policy for agent-to-agent delegation."
        },
        "relay.detection.useLoginShell": {
          "type": "boolean",
          "default": true,
          "description": "Resolve agent CLIs from the user environment, login shell and common platform install locations."
        },
        "relay.executables.copilot": {
          "type": "string",
          "default": "copilot",
          "description": "GitHub Copilot CLI executable or absolute path."
        },
        "relay.antigravity.permissions.allow": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Allow-rule granulari per Antigravity headless, ad esempio command(rg *), command(cat *) o command(sed *). Non usare wildcard globali senza comprenderne l’impatto."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "package": "node build.mjs --package",
    "test:smoke": "node build.mjs && node test-extension-load.mjs && node test-webview-boot.js && node test-smoke.js",
    "test:core": "node test-core.mjs",
    "test": "npm run typecheck && node test-core.mjs && node test-windows-launcher.mjs && node build.mjs && node test-extension-load.mjs && node test-webview-boot.js && node test-smoke.js && node test-webview-init-order.mjs && node test-remote-app-syntax.mjs && node test-relay-regressions.mjs",
    "test:webview-boot": "node build.mjs && node test-extension-load.mjs && node test-webview-boot.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.28.1",
    "jsdom": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Relay runs local coding agents that can read and modify the open workspace."
    }
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.4.2"
  }
}
